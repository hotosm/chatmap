# Local backend (compose.dev.yml). On a phone over USB, run first:
#   adb reverse tcp:8000 tcp:8000
# so the phone's localhost:8000 reaches this machine.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Connectivity detection (optional, these are the defaults)
# EXPO_PUBLIC_HEALTH_INTERVAL_MS=30000
# EXPO_PUBLIC_HEALTH_TIMEOUT_MS=5000
# EXPO_PUBLIC_HEALTH_FAILURES_TO_OFFLINE=2
# EXPO_PUBLIC_HEALTH_RETRY_MIN_MS=5000
# EXPO_PUBLIC_HEALTH_RETRY_MAX_MS=60000
